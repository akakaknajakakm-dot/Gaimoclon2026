
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0d0d0d">
<title>ALLSTAR UNITED ESPORTS</title>
<meta name="description" content="Official website of ALLSTAR UNITED ESPORTS. Rise Together, Fight Together, Win Together.">

<style>
:root {
  --red: #e50914;
  --black: #0d0d0d;
  --white: #ffffff;
  --gray: #171717;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  background: var(--black);
  color: var(--white);
  font-family: Arial, Helvetica, sans-serif;
  line-height: 1.6;
}

a {
  color: inherit;
  text-decoration: none;
}

header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(13,13,13,.95);
  border-bottom: 1px solid #292929;
  backdrop-filter: blur(12px);
}

.navbar {
  max-width: 1150px;
  min-height: 72px;
  margin: auto;
  padding: 12px 22px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
}

.logo {
  font-size: 19px;
  font-weight: 900;
  letter-spacing: 1px;
}

.logo span {
  color: var(--red);
}

nav {
  display: flex;
  gap: 22px;
  font-size: 13px;
}

nav a:hover {
  color: var(--red);
}

.hero {
  min-height: 600px;
  padding: 90px 22px;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  background:
    radial-gradient(ellipse at 50% 65%, #5b090f 0%, transparent 52%),
    linear-gradient(180deg, #101010, #0d0d0d);
  border-bottom: 1px solid #292929;
}

.hero-content {
  max-width: 850px;
}

.tag {
  color: #ff454d;
  font-size: 12px;
  font-weight: bold;
  letter-spacing: 5px;
  text-transform: uppercase;
}

.hero h1 {
  margin: 22px 0 12px;
  font-size: clamp(36px, 8vw, 76px);
  line-height: 1.05;
  font-weight: 900;
  letter-spacing: -2px;
}

.hero h1 span {
  color: var(--red);
}

.hero p {
  color: #bcbcbc;
  font-size: 15px;
  letter-spacing: 2px;
  margin-bottom: 30px;
}

.btn {
  display: inline-block;
  padding: 13px 24px;
  background: var(--red);
  border: 1px solid var(--red);
  color: white;
  font-weight: bold;
  font-size: 13px;
  transition: .25s;
}

.btn:hover {
  background: transparent;
  transform: translateY(-3px);
}

section {
  padding: 80px 22px;
  max-width: 1150px;
  margin: auto;
}

.section-heading {
  text-align: center;
  margin-bottom: 38px;
}

.section-heading h2 {
  font-size: clamp(27px, 5vw, 40px);
  font-weight: 900;
}

.section-heading h2 span {
  color: var(--red);
}

.section-heading p {
  color: #999;
  font-size: 14px;
  margin-top: 8px;
}

.players {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
}

.player-card {
  background: var(--gray);
  border: 1px solid #303030;
  overflow: hidden;
  transition: .25s;
}

.player-card:hover {
  transform: translateY(-6px);
  border-color: var(--red);
  box-shadow: 0 12px 30px #e509141c;
}

.player-image {
  height: 240px;
  background: #202020;
  overflow: hidden;
}

.player-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.player-info {
  padding: 20px;
  border-top: 2px solid var(--red);
}

.player-info small {
  color: #ff454d;
  font-size: 11px;
  font-weight: bold;
  letter-spacing: 2px;
}

.player-info h3 {
  font-size: 24px;
  margin: 5px 0;
  overflow-wrap: anywhere;
}

.player-info p {
  color: #999;
  font-size: 13px;
}

.about {
  max-width: none;
  background: #141414;
  text-align: center;
}

.about-content {
  max-width: 760px;
  margin: auto;
}

.about p {
  color: #bdbdbd;
  margin-top: 15px;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 15px;
  margin-top: 35px;
}

.stat {
  padding: 20px 10px;
  border: 1px solid #333;
  background: #101010;
}

.stat strong {
  display: block;
  color: var(--red);
  font-size: 25px;
}

.stat span {
  color: #aaa;
  font-size: 12px;
}

.contact {
  text-align: center;
}

.contact p {
  color: #aaa;
  margin: 12px 0 25px;
}

.socials {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 12px;
}

.socials a {
  padding: 10px 18px;
  border: 1px solid #444;
  font-size: 13px;
  transition: .2s;
}

.socials a:hover {
  border-color: var(--red);
  color: #ff454d;
}

footer {
  padding: 25px 18px;
  text-align: center;
  color: #777;
  font-size: 12px;
  border-top: 1px solid #292929;
}

footer span {
  color: var(--red);
}

@media (max-width: 700px) {
  .navbar {
    flex-direction: column;
    padding: 14px 10px;
  }

  nav {
    gap: 15px;
    flex-wrap: wrap;
    justify-content: center;
    font-size: 12px;
  }

  .hero {
    min-height: 510px;
    padding: 70px 18px;
  }

  .hero h1 {
    letter-spacing: -1px;
  }

  section {
    padding: 60px 16px;
  }

  .players {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .player-image {
    height: 190px;
  }

  .player-info {
    padding: 13px;
  }

  .player-info h3 {
    font-size: 19px;
  }

  .stats {
    gap: 8px;
  }

  .stat {
    padding: 15px 5px;
  }

  .stat strong {
    font-size: 20px;
  }
}

@media (max-width: 360px) {
  .players {
    grid-template-columns: 1fr;
  }

  .player-image {
    height: 260px;
  }
}
</style>
</head>

